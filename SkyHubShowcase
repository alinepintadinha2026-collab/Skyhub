 local plus=make('TextButton',{Text='+',TextSize=14,TextColor3=C.white,
  BackgroundColor3=Color3.fromRGB(65,60,82),AnchorPoint=Vector2.new(1,0),
  Position=UDim2.new(1,-7,0,48),Size=UDim2.fromOffset(23,26),ZIndex=12},row);corner(plus,7)
 local hit=make('TextButton',{Text='',AutoButtonColor=false,BackgroundTransparency=1,
  Active=true,ZIndex=12,Position=UDim2.fromOffset(36,42),
  Size=UDim2.new(1,-72,0,40)},row)
 local bar=make('Frame',{BackgroundColor3=Color3.fromRGB(65,60,82),
  BorderSizePixel=0,Position=UDim2.new(0,0,.5,-4),Size=UDim2.new(1,0,0,8)},hit);corner(bar,5)
 local fill=make('Frame',{BackgroundColor3=C.gold,BorderSizePixel=0,Size=UDim2.fromScale(0,1)},bar);corner(fill,5)
 local knob=make('Frame',{BackgroundColor3=C.white,AnchorPoint=Vector2.new(.5,.5),
  Size=UDim2.fromOffset(18,18),ZIndex=13},bar);corner(knob,10)
 local decimals=tonumber(format:match('%%%.(%d+)f')) or 0
 local scale=10^decimals
 local step=1/scale
 local current=tonumber(value) or min
 local activeInput=nil
 local draggingMouse=false
 local function set(v)
  current=math.floor(math.clamp(v,min,max)*scale+0.5)/scale
  current=math.clamp(current,min,max)
  local ratio=math.clamp((current-min)/(max-min),0,1)
  fill.Size=UDim2.fromScale(ratio,1)
  knob.Position=UDim2.fromScale(ratio,.5)
  caption.Text=_G.SkyHubTranslate(name)
  valueLabel.Text=string.format(format,current)
  callback(current)
 end
 local function update(x)
  if hit.AbsoluteSize.X<=0 then return end
  set(min+(max-min)*math.clamp((x-hit.AbsolutePosition.X)/hit.AbsoluteSize.X,0,1))
 end
 track(hit.InputBegan,function(input)
  if input.UserInputType==Enum.UserInputType.Touch then
   if not activeInput then activeInput=input;update(input.Position.X) end
  elseif input.UserInputType==Enum.UserInputType.MouseButton1 then
   draggingMouse=true;update(input.Position.X)
  end
 end,pageConnections)
 track(UIS.InputChanged,function(input)
  if not row.Parent then return end
  if activeInput and input==activeInput then
   update(input.Position.X)
  elseif draggingMouse and input.UserInputType==Enum.UserInputType.MouseMovement then
   update(input.Position.X)
  end
 end,pageConnections)
 track(UIS.InputEnded,function(input)
  if input==activeInput then activeInput=nil end
  if input.UserInputType==Enum.UserInputType.MouseButton1 then draggingMouse=false end
 end,pageConnections)
 track(minus.Activated,function() set(current-step) end,pageConnections)
 track(plus.Activated,function() set(current+step) end,pageConnections)
 set(current)
end
