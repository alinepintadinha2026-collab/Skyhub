function toggle(p,name,ref,key,callback)
 local row=make('Frame',{BackgroundColor3=Color3.fromRGB(38,31,39),BackgroundTransparency=1,ZIndex=9,Size=UDim2.new(1,0,0,38)},p);corner(row,6)
 local caption=label(row,'✦ '.._G.SkyHubTranslate(name),12,Color3.fromRGB(246,217,175))
 caption.Position=UDim2.fromOffset(8,0);caption.Size=UDim2.new(1,-65,1,0)
 local b=make('TextButton',{Text='',Active=true,AutoButtonColor=false,ZIndex=12,AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-7,.5,0),Size=UDim2.fromOffset(44,26)},row);corner(b,13)
 local dot=make('Frame',{BackgroundColor3=C.white,Size=UDim2.fromOffset(17,17),Active=false},b);corner(dot,9)
 local function refresh()
  if not b.Parent then return end
  b.BackgroundColor3=ref[key] and Color3.fromRGB(196,150,69) or Color3.fromRGB(65,65,75)
  dot.Position=UDim2.fromOffset(ref[key] and 24 or 3,4)
 end
 local busy=false
 track(b.Activated,function()
  if busy then return end
  busy=true
  local previous=not not ref[key]
  ref[key]=not previous
  refresh() -- visualiza antes de qualquer reconstrução da aba
  if callback then
   local ok,err=pcall(callback,ref[key])
   if not ok then
    ref[key]=previous
    warn('[SKYHUB TOGGLE '..tostring(key)..'] '..tostring(err))
    refresh()
   end
  end
  busy=false
 end,pageConnections)
 refresh();return row
end

