-- A transicao usa o proprio modelo 3D da capa fechada, nao um retangulo.
local animationBusy=false
local iconHome=UDim2.fromOffset(12,90)
local iconSmall=UDim2.fromOffset(48,54)
local bookScale=Instance.new('UIScale');bookScale.Scale=1;bookScale.Parent=root
function tweenWait(object,duration,properties,style,direction)
 local tw=TweenService:Create(object,TweenInfo.new(duration,style or Enum.EasingStyle.Quint,direction or Enum.EasingDirection.InOut),properties)
 tw:Play();tw.Completed:Wait()
end
function minimizeDarkhold()
 if animationBusy or not root.Visible then return end
 animationBusy=true
 local rp,rs=root.AbsolutePosition,root.AbsoluteSize
 -- Fechamento: o grimorio aberto diminui antes de revelar a capa fechada.
 tweenWait(bookScale,.16,{Scale=.84},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
 root.Visible=false;bookScale.Scale=1
 icon.Position=UDim2.fromOffset(rp.X+rs.X*.38,rp.Y+rs.Y*.22)
 icon.Size=UDim2.fromOffset(math.max(48,rs.X*.24),math.max(54,rs.Y*.65))
 icon.Visible=true
 tweenWait(icon,.5,{Position=iconHome,Size=iconSmall},Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
 animationBusy=false
end
function restore()
 if animationBusy or root.Visible then return end
 animationBusy=true
 local rp,rs=root.Position,root.Size
 -- A capa cresce no canto, viaja ao centro e so entao o livro abre.
 tweenWait(icon,.42,{Position=UDim2.fromOffset(rp.X.Offset+rs.X.Offset*.38,rp.Y.Offset+rs.Y.Offset*.22),Size=UDim2.fromOffset(math.max(48,rs.X.Offset*.24),math.max(54,rs.Y.Offset*.65))},Enum.EasingStyle.Quint,Enum.EasingDirection.InOut)
 icon.Visible=false
 icon.Size=iconSmall;icon.Position=iconHome
 bookScale.Scale=.78;root.Visible=true
 tweenWait(bookScale,.42,{Scale=1},Enum.EasingStyle.Back,Enum.EasingDirection.Out)
 animationBusy=false
end
track(minimize.Activated,minimizeDarkhold)
function draggable(target,handle,onTap)
 local dragging,moved=false,false;local touch,start,initial
 track(handle.InputBegan,function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
   dragging=true;moved=false;touch=input.UserInputType==Enum.UserInputType.Touch and input or nil
   start=input.Position;initial=target.Position
  end
 end)
 track(UIS.InputChanged,function(input)
  if not dragging then return end
  if input.UserInputType~=Enum.UserInputType.MouseMovement and input~=touch then return end
  local delta=input.Position-start;if delta.Magnitude>6 then moved=true end
  local size=target.AbsoluteSize
  local x,y=bounds(initial.X.Offset+delta.X,initial.Y.Offset+delta.Y,size.X,size.Y)
  target.Position=UDim2.fromOffset(x,y)
 end)
 track(UIS.InputEnded,function(input)
  if dragging and (input.UserInputType==Enum.UserInputType.MouseButton1 or input==touch) then
   dragging=false;touch=nil;if onTap and not moved then onTap() end
  end
 end)
end
